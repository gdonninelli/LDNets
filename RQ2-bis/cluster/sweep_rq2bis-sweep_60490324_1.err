# Gate: finite runs + comparison with the RQ2 reduced-budget value and the paper reference.
# RQ2 (200+500, L0, d_s = 12, seed 0): test NRMSE 1.765e-02. Paper (200+5000): 7.37e-03.
RQ2_REF, PAPER_REF = 1.765e-02, 7.37e-03
gate = load('runs').query("variant == 'L0' and width == @W_STAR and depth == @L_STAR and d_s == @N_STAR")
assert len(gate) == len(SEEDS) and np.all(np.isfinite(gate['nrmse_test'])), 'Stage 0 did not finish or diverged: stop and discuss'
if (gate.n_iters < EPOCHS_BFGS).any():
    print(f'warning: scipy stopped early in some runs (iterations {list(gate.n_iters)}): "fixed budget" comparisons are not at equal iterations')
med = gate['nrmse_test'].median()
print(f'canonical BFGS-only median test NRMSE {med:.3e}   RQ2 reduced-budget {RQ2_REF:.3e}   paper ~{PAPER_REF:.3e}')
print(f'max/min across seeds: {gate["nrmse_test"].max() / gate["nrmse_test"].min():.2f} (warning if > 2, protocol Sec. 11)')
assert med < 5 * RQ2_REF, 'BFGS-only stalls far above the RQ2 value: tune once on validation, then freeze or stop'
