   "source": [
    "## Stage 5. Thread scaling and serial timing (Pass T)\n",
    "\n",
    "Run this section alone, serially, plugged in, with nothing else running. TensorFlow only accepts its thread counts before it runs its first operation, so every timing is done in a **fresh process** (`timing_worker.py` re-executes the tagged setup cells of this notebook with the thread count fixed first). The unit measured is **seconds per joint function/gradient evaluation** on a stored run (median of 3 repeats of 20 evaluations, after a warm-up): it needs no new BFGS run and does not depend on how many line-search steps an iteration takes. `thread_scaling` times the canonical L0 run with 1, 2, 4, 6, 12 and 18 threads; `spot_timing` then times every stored configuration (L0 and L2, seed 0) at the chosen thread count and stores `timing.csv`. From then on `medians()` estimates the training time of a configuration as `n_fev` $\\times$ `s_per_eval` (Pass T). Pass-A times from the sweeps stay orientation only."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "NB_NAME = 'TestCase_C_bis.ipynb'\n",
    "\n",
    "def run_worker(threads, cfgs):\n",
    "    '''Times configurations in a FRESH process: TensorFlow only accepts its thread counts before it runs its first operation,\n",
    "    so one process per thread count (timing_worker.py re-executes this notebook's tagged setup cells).'''\n",
    "    out = subprocess.run([sys.executable, 'timing_worker.py', str(threads), NB_NAME, json.dumps(cfgs)], capture_output = True, text = True)\n",
    "    lines = [l for l in out.stdout.splitlines() if l.startswith('RESULT ')]\n",
    "    assert lines, out.stderr[-3000:]\n",
    "    return json.loads(lines[-1][len('RESULT '):])\n",
    "\n",
    "def hardware_record(threads):\n",
    "    sysctl = lambda k: subprocess.run(['sysctl', '-n', k], capture_output = True, text = True).stdout.strip()\n",
    "    rec = dict(chip = sysctl('machdep.cpu.brand_string'), perf_cores = sysctl('hw.perflevel0.logicalcpu'), eff_cores = sysctl('hw.perflevel1.logicalcpu'),\n",
    "               os = platform.platform(), python = sys.version.split()[0], tensorflow = tf.__version__, numpy = np.__version__,\n",
    "               threads = threads)\n",
    "    (OUT / 'hardware.json').write_text(json.dumps(rec, indent = 2))\n",
    "    return rec\n",
    "\n",
    "def thread_scaling():\n",
    "    '''Seconds per function/gradient evaluation vs thread count on the canonical stored run (one fresh process per count); speedup and efficiency.'''\n",
    "    cfg = [*CANON, SEEDS[0]]\n",
    "    assert (OUT / 'weights' / f'{run_id(*cfg)}.npy').exists(), 'run Stage 0 first'\n",
    "    rows = np.array([(t, run_worker(t, [cfg])[0]) for t in [1, 2, 4, 6, 12, 18]])\n",
    "    for t, s in rows:\n",
    "        print(f'threads {int(t):3d}: {s:.4f} s/evaluation')\n",
    "    fig, axs = plt.subplots(1, 2, figsize = (12, 4))\n",
    "    axs[0].plot(rows[:, 0], rows[0, 1] / rows[:, 1], 'o-')\n",
    "    axs[0].plot(rows[:, 0], rows[:, 0], '--', label = 'ideal')\n",
    "    axs[0].set(xlabel = 'threads', ylabel = 'speedup')\n",
    "    axs[0].legend()\n",
    "    axs[1].plot(rows[:, 0], (rows[0, 1] / rows[:, 1]) / rows[:, 0], 'o-')\n",
    "    axs[1].set(xlabel = 'threads', ylabel = 'parallel efficiency')\n",
    "    for ax in axs:\n",
    "        ax.grid(True, alpha = 0.3)\n",
    "    fig.suptitle('Thread scaling (Pass T, canonical run)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "    best = int(rows[np.argmax(rows[0, 1] / rows[:, 1] / np.sqrt(rows[:, 0])), 0])   # best speedup per sqrt(thread) trade-off\n",
    "    print(f'suggested thread count: {best}')\n",
    "    return best\n",
    "\n",
    "def spot_timing(threads):\n",
    "    '''Pass T: seconds per function/gradient evaluation of every stored configuration (seed 0), one process, random order, thread count fixed.\n",
    "    Training time of a run is then n_fev x s_per_eval. The first configuration is timed again at the end (throttling check).'''\n",
    "    hardware_record(threads)\n",
    "    runs = load('runs')\n",
    "    cfgs = [[*c, SEEDS[0]] for c in runs[runs.seed == SEEDS[0]][CFG_KEYS].drop_duplicates().itertuples(index = False, name = None)]\n",
    "    cfgs = [c for c in cfgs if (OUT / 'weights' / f'{run_id(*c)}.npy').exists()]\n",
    "    cfgs = [cfgs[i] for i in np.random.RandomState(0).permutation(len(cfgs))]     # randomized order (protocol Sec. 7)\n",
    "    times = run_worker(threads, cfgs)\n",
    "    pd.DataFrame([dict(zip(CFG_KEYS, c[:-1]), threads = threads, s_per_eval = s) for c, s in zip(cfgs, times)]).to_csv(OUT / 'timing.csv', index = False)\n",
    "    again = run_worker(threads, [cfgs[0]])[0]\n",
    "    print(f'timed {len(cfgs)} configurations; throttling check: first configuration {again:.4f} vs {times[0]:.4f} s/evaluation '\n",
    "          f'({abs(again / times[0] - 1):.1%} apart; repeat the session if more than 10%)')\n",
    "\n",
    "# Run in order, serially, plugged in, nothing else on the machine:\n",
    "# best = thread_scaling()\n",
    "# spot_timing(best)"
   ]
