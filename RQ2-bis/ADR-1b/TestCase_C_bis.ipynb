    "CFG_KEYS = ['variant', 'K', 'width', 'depth', 'd_s']\n",
    "RUN_KEYS = CFG_KEYS + ['seed']\n",
    "EXTRA_KEYS = {'runs': [], 'predictions': ['sample'], 'curves': ['iter']}\n",
    "EXTRA_COLS = ['act_mae_test', 'act_miss_test']              # case-C columns of runs.csv (NaN for a failed run)\n",
    "TH_ACT = 0.5                        # activation threshold (physical units)\n",
    "\n",
    "def run_id(variant, K, width, depth, d_s, seed):\n",
    "    return f'{variant}_K{K}_w{width}_L{depth}_ds{d_s}_s{seed}'\n",
    "\n",
    "def append(name, df):\n",
    "    path = OUT / f'{name}.csv'\n",
    "    df.to_csv(path, mode = 'a', header = not path.exists(), index = False)\n",
    "\n",
    "def load(name):\n",
    "    '''Results table `name` ('runs', 'predictions' or 'curves'). A run interrupted while saving can leave duplicated rows: the last ones are kept.'''\n",
    "    return pd.read_csv(OUT / f'{name}.csv').drop_duplicates(subset = RUN_KEYS + EXTRA_KEYS[name], keep = 'last')\n",
    "\n",
    "def with_key(df, key):\n",
    "    for i, (k, v) in enumerate(key.items()):\n",
    "        df.insert(i, k, v)\n",
    "    return df\n",
    "\n",
    "def nrmse_rho(app, ref):\n",
    "    '''Aggregated metrics of the original script.'''\n",
    "    nrmse = np.sqrt(np.mean(np.square(app - ref))) / (np.max(ref) - np.min(ref))\n",
    "    return nrmse, 1.0 - scipy.stats.pearsonr(app.reshape(-1), ref.reshape(-1))[0]\n",
    "\n",
    "def nrmse_only(app, ref):\n",
    "    '''NRMSE without the Pearson pass (for the iteration checkpoints, where rho is not needed).'''\n",
    "    return float(np.sqrt(np.mean(np.square(app - ref))) / (np.max(ref) - np.min(ref)))\n",
    "\n",
    "def rel_norm(a, ref):\n",
    "    '''||a_i|| / ||ref_i|| for every sample i (norm over time and space).'''\n",
    "    return np.linalg.norm(a.reshape(len(a), -1), axis = 1) / np.linalg.norm(ref.reshape(len(ref), -1), axis = 1)\n",
    "\n",
    "def activation_time(u):\n",
    "    '''First t with u >= TH_ACT (physical): u [..., T, P] -> [..., P] times in ms (nan where never).'''\n",
    "    m = u >= TH_ACT\n",
    "    return np.where(m.any(axis = -2), np.argmax(m, axis = -2).astype(float), np.nan)\n",
    "\n",
    "def act_metrics(app, ref):\n",
    "    '''Activation-time MAE (points where both activate) and fraction of FOM-activating points the prediction misses: ((mae, miss) per sample, (mae, miss) overall).'''\n",
    "    a, r = activation_time(app[..., 0]), activation_time(ref[..., 0])      # [S, P]\n",
    "    act, both = np.isfinite(r), np.isfinite(r) & np.isfinite(a)\n",
    "    err = np.where(both, np.abs(a - r), 0.0)\n",
    "    def red(ax):\n",
    "        n_both, n_act = both.sum(ax), act.sum(ax)\n",
    "        return err.sum(ax) / np.where(n_both > 0, n_both, np.nan), (act & ~both).sum(ax) / np.where(n_act > 0, n_act, np.nan)\n",
    "    return red(1), red(None)\n",
    "\n",
    "def proj_residual(ref, K):\n",
    "    '''(y - y_bar) - P_K (y - y_bar): the part of the field that K Legendre modes cannot represent.'''\n",
    "    B = PHI[:, :K]\n",
    "    f = (ref[..., 0] - y_bar).reshape(-1, P)\n",
    "    return (f - ((f * w) @ B) @ B.T).reshape(ref.shape)\n",
    "\n",
    "def prediction_table(app, ref, K_floor):\n",
    "    eps_total = rel_norm(app - ref, ref)\n",
    "    eps_proj = rel_norm(proj_residual(ref, K_floor), ref)\n",
    "    (act_mae, act_miss), _ = act_metrics(app, ref)\n",
    "    return pd.DataFrame(dict(\n",
    "        sample = np.arange(len(ref)),\n",
    "        nrmse = np.sqrt(np.mean(np.square(app - ref), axis = (1, 2, 3))) / (ref.max() - ref.min()),\n",
    "        one_minus_rho = [1.0 - scipy.stats.pearsonr(a.reshape(-1), r.reshape(-1))[0] for a, r in zip(app, ref)],\n",
    "        eps_total = eps_total, eps_proj = eps_proj, eff_ratio = eps_total / eps_proj,\n",
    "        act_mae = act_mae, act_miss = act_miss))"
   ]
