   "source": [
    "SHOW_COLS = ['variant', 'K', 'width', 'depth', 'd_s', 'n_runs', 'n_failed', 'dyn', 'rec', 'p_total', 'med', 'lo', 'hi', 'fevs', 'time', 'time_src']\n",
    "\n",
    "def medians(metric = 'nrmse_test', variant = None):\n",
    "    '''Median, min and max over the seeds of `metric` per configuration. Failed runs are left out of the statistics but counted in n_failed.\n",
    "    time = n_fev x s_per_eval from timing.csv (Pass T) where available, else the training time of the sweep (Pass A, shared machine).'''\n",
    "    runs = load('runs')\n",
    "    if variant:\n",
    "        runs = runs[runs.variant == variant]\n",
    "    g = runs.groupby(CFG_KEYS)\n",
    "    tab = pd.DataFrame(dict(med = g[metric].median(), lo = g[metric].min(), hi = g[metric].max(),\n",
    "                            n_runs = g.size(), n_failed = g['failed'].sum(),\n",
    "                            dyn = g['dyn_params'].first(), rec = g['rec_params'].first(), p_total = g['p_total'].first(),\n",
    "                            flops = g['flops_total'].median(), fevs = g['n_fev'].median(), iters = g['n_iters'].median(),\n",
    "                            time_a = g['train_time_s'].median())).reset_index()\n",
    "    tab['time'], tab['time_src'] = tab['time_a'], 'A'\n",
    "    if (OUT / 'timing.csv').exists():\n",
    "        tm = pd.read_csv(OUT / 'timing.csv')[CFG_KEYS + ['s_per_eval']]\n",
    "        tab = tab.merge(tm, how = 'left', on = CFG_KEYS)\n",
    "        has = tab['s_per_eval'].notna()\n",
    "        tab.loc[has, 'time'] = tab.loc[has, 'fevs'] * tab.loc[has, 's_per_eval']\n",
    "        tab.loc[has, 'time_src'] = 'T'\n",
    "    return tab.sort_values(CFG_KEYS).reset_index(drop = True)\n",
    "\n",
    "def show(variant = None):\n",
    "    print(medians(variant = variant)[SHOW_COLS].to_string(index = False, float_format = lambda v: f'{v:.4g}'))\n",
    "\n",
    "def arm(df, variant):\n",
    "    '''Width-sweep slice of an arm: depth L*, and the latent size and K of ARM[variant].'''\n",
    "    a = ARM[variant]\n",
    "    return df[(df.variant == variant) & (df.K == a['K']) & (df.d_s == a['d_s']) & (df.depth == L_STAR)]\n",
    "\n",
    "def plot_capacity(variant = 'L0', metric = 'nrmse_test'):\n",
    "    '''Test error vs P_dyn and vs P_total (log-log): width sweep (line + min-max band), other configurations of the arm as markers.'''\n",
    "    tab = medians(metric, variant)\n",
    "    main = arm(tab, variant)\n",
    "    extra = tab.drop(main.index)\n",
    "    fig, axs = plt.subplots(1, 2, figsize = (12, 4), sharey = True)\n",
    "    for ax, xcol in zip(axs, ['dyn', 'p_total']):\n",
    "        ax.errorbar(main[xcol], main['med'], yerr = [main['med'] - main['lo'], main['hi'] - main['med']],\n",
    "                    fmt = 'o-', capsize = 3, label = 'width sweep (%s, L = %d, n = %d)' % (variant, L_STAR, ARM[variant]['d_s']))\n",
    "        ax.scatter(extra[xcol], extra['med'], c = 'tab:orange', s = 40, zorder = 3, label = 'other configurations')\n",
    "        ax.set(xscale = 'log', yscale = 'log', xlabel = 'P_dyn' if xcol == 'dyn' else 'P_total', ylabel = 'test NRMSE')\n",
    "        ax.grid(True, which = 'both', alpha = 0.3)\n",
    "        ax.legend()\n",
    "    fig.suptitle(f'{variant} capacity: test NRMSE vs parameters (median, min-max band over seeds)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def capacity_fit(variant = 'L0'):\n",
    "    '''Power law E = E_inf + a * P_dyn^-alpha on the width-sweep medians (bootstrap CI over seeds) and the knee (protocol Sec. 10).'''\n",
    "    import scipy.optimize\n",
    "    sub = arm(load('runs'), variant)\n",
    "    assert len(sub), 'no width-sweep results: run the stage first'\n",
    "    P = sub.groupby('width')['dyn_params'].first().sort_index()\n",
    "    med = sub.groupby('width')['nrmse_test'].median().reindex(P.index).to_numpy(float)\n",
    "    P = P.to_numpy(float)\n",
    "    gv = sub.groupby('width')['nrmse_valid'].median()\n",
    "    print(f'knee: width {gv[gv <= 1.1 * gv.min()].index.min()} (smallest width with the validation median within 10% of the best)')\n",
    "    try:\n",
    "        f = lambda p, einf, a, alpha: einf + a * p ** -alpha\n",
    "        (einf, a, alpha), _ = scipy.optimize.curve_fit(f, P, med, p0 = (med.min() * 0.5, med[0], 0.5),\n",
    "                                                       method = 'dogbox', bounds = ([0, 0, 0], [med.min(), np.inf, 5]))   # not 'trf': its SVD segfaults in the old OpenBLAS here\n",
    "        boots, rng = [], np.random.default_rng(0)\n",
    "        for _ in range(200):\n",
    "            m = np.array([rng.choice(sub[sub.width == w]['nrmse_test'].to_numpy(float), size = len(SEEDS), replace = True).mean()\n",
    "                          for w in sorted(sub.width.unique())])\n",
    "            try:\n",
    "                boots.append(scipy.optimize.curve_fit(f, P, m, p0 = (einf, a, alpha), method = 'dogbox', bounds = ([0, 0, 0], [med.min(), np.inf, 5]))[0][2])\n",
    "            except Exception:\n",
    "                pass\n",
    "        if not boots:\n",
    "            print(f'{variant}: fit converged but all bootstrap refits failed; point estimate only: E_inf = {einf:.3e}, a = {a:.3e}, alpha = {alpha:.3f}')\n",
    "            return\n",
    "        lo, hi = np.quantile(boots, [0.025, 0.975])\n",
    "        print(f'{variant} power law: E_inf = {einf:.3e}, a = {a:.3e}, alpha = {alpha:.3f} (95% CI [{lo:.3f}, {hi:.3f}], {len(boots)} fits)')\n",
    "        print('H1:', 'consistent with a capacity law' if lo > 0.1 else 'FALSIFIED (exponent CI reaches below 0.1: flat in P_dyn)')\n",
    "    except Exception:\n",
    "        slope = (np.log10(med[-1]) - np.log10(med[0])) / (np.log10(P[-1]) - np.log10(P[0]))\n",
    "        print(f'{variant}: power-law fit did not converge; endpoint log-log slope {slope:.3f}')\n",
    "        print('H1:', 'consistent with a capacity law' if slope < -0.1 else 'FALSIFIED (flat in P_dyn)')\n",
    "\n",
    "def plot_iter_curves(variant = 'L0'):\n",
    "    '''Test NRMSE vs BFGS iterations, one curve per width (median, min-max band): the H3 surface.'''\n",
    "    cv = arm(load('curves'), variant)\n",
    "    assert len(cv), 'no curves: run the stage first'\n",
    "    fig, ax = plt.subplots(figsize = (7, 4.5))\n",
    "    for w, g in sorted(cv.groupby('width')):\n",
    "        q = g.groupby('iter')['nrmse_test'].quantile([0, 0.5, 1]).unstack()\n",
    "        ax.plot(q.index, q[0.5], 'o-', ms = 4, label = f'w = {w}')\n",
    "        ax.fill_between(q.index, q[0], q[1], alpha = 0.15)\n",
    "    ax.set(xscale = 'log', yscale = 'log', xlabel = 'BFGS iterations', ylabel = 'test NRMSE')\n",
    "    ax.set_xticks(CHECKPOINTS)\n",
    "    ax.set_xticklabels(CHECKPOINTS)\n",
    "    ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    ax.legend()\n",
    "    fig.suptitle(f'{variant}: error vs iterations per width (H3)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "    n_w = cv.width.nunique()\n",
    "    for it in (500, EPOCHS_BFGS):\n",
    "        m = cv[cv.iter == it].groupby('width')['nrmse_test'].median().sort_index().to_numpy()\n",
    "        if len(m) < n_w:\n",
    "            print(f'iter {it}: checkpoint missing for {n_w - len(m)} width(s) (scipy stopped early?): no verdict')\n",
    "            continue\n",
    "        print(f'iter {it}: monotone decreasing in width: {bool(np.all(np.diff(m) < 0))}  medians {np.array2string(m, precision = 3)}')\n",
    "        if it == EPOCHS_BFGS:\n",
    "            print('H3:', 'consistent with an iteration-limited regime' if not np.all(np.diff(m) < 0)\n",
    "                  else 'FALSIFIED (monotone decreasing up to the largest P_dyn)')\n",
    "\n",
    "def plot_cost_tradeoff(variants = ('L0',)):\n",
    "    '''Test NRMSE vs function evaluations (hardware-independent) and vs training time (Pass T where available, else Pass A).'''\n",
    "    tab = medians()\n",
    "    tab = tab[tab.variant.isin(variants)]\n",
    "    fig, axs = plt.subplots(1, 2, figsize = (12, 4), sharey = True)\n",
    "    for ax, col, label in zip(axs, ['fevs', 'time'], ['function/gradient evaluations', 'training time [s] (Pass T estimate where available, else Pass A)']):\n",
    "        ax.errorbar(tab[col], tab['med'], yerr = [tab['med'] - tab['lo'], tab['hi'] - tab['med']], fmt = 'o', capsize = 3)\n",
    "        ax.set(xscale = 'log', yscale = 'log', xlabel = label, ylabel = 'test NRMSE')\n",
    "        ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    fig.suptitle('Cost trade-offs (headline: left panel)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def pareto_front(variant = 'L0'):\n",
    "    '''Pareto front of (median time, median test NRMSE) within an arm, and the H5 check.'''\n",
    "    tab = medians(variant = variant).dropna(subset = ['med'])\n",
    "    pts = tab[['time', 'med']].to_numpy()\n",
    "    is_pareto = np.array([not np.any((pts[:, 0] <= p[0]) & (pts[:, 1] <= p[1]) & ((pts[:, 0] < p[0]) | (pts[:, 1] < p[1]))) for p in pts])\n",
    "    par = tab[is_pareto].sort_values('time')\n",
    "    fig, ax = plt.subplots(figsize = (7, 4.5))\n",
    "    ax.loglog(tab['time'], tab['med'], 'o', label = 'all configurations')\n",
    "    ax.loglog(par['time'], par['med'], 's-', label = 'Pareto front')\n",
    "    ax.set(xlabel = 'training time [s] (Pass T estimate where available, else Pass A)', ylabel = 'test NRMSE')\n",
    "    ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    ax.legend()\n",
    "    fig.suptitle(f'{variant}: Pareto front, error vs time')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "    print(par[['K', 'width', 'depth', 'd_s', 'p_total', 'time', 'time_src', 'med']].to_string(index = False))\n",
    "    best = tab.loc[tab['med'].idxmin()]\n",
    "    cheap = tab[tab['med'] <= 1.1 * best['med']].sort_values('time').iloc[0]\n",
    "    print(f'best: K={best.K} w={best.width} L={best.depth} n={best.d_s} (P_total {best.p_total}, time {best.time:.4g} s); '\n",
    "          f'cheapest within 10%: K={cheap.K} w={cheap.width} L={cheap.depth} n={cheap.d_s} (P_total {cheap.p_total}, time {cheap.time:.4g} s)')\n",
    "    print('H5:', 'FALSIFIED (the largest network has the lowest error)' if best['p_total'] == tab['p_total'].max()\n",
    "          else 'consistent with no free lunch (the largest network is not the best)')\n",
    "\n",
    "def time_to_target():\n",
    "    '''Median over seeds of the first checkpoint time with validation NRMSE <= target (Pass A time without checkpoint overhead).\n",
    "    A seed that never reaches the target counts as infinite; n_hit is the number of seeds that did.'''\n",
    "    cv = load('curves')\n",
    "    assert len(cv), 'no curves: run the sweeps first'\n",
    "    rows = []\n",
    "    for cfg, g in cv.groupby(CFG_KEYS):\n",
    "        row = dict(zip(CFG_KEYS, cfg))\n",
    "        for tgt in TARGETS:\n",
    "            t = [s[s.nrmse_valid <= tgt]['time_s'].min() if (s.nrmse_valid <= tgt).any() else np.inf for _, s in g.groupby('seed')]\n",
    "            row[f'<= {tgt:g}'], row[f'n_hit {tgt:g}'] = np.median(t), int(np.isfinite(t).sum())\n",
    "        rows.append(row)\n",
    "    print(pd.DataFrame(rows).to_string(index = False, float_format = lambda v: f'{v:.4g}'))\n",
    "\n",
    "def h2_split(variant = 'L0'):\n",
    "    '''Linear fit of the time per iteration vs P_dyn on the width sweep (H2: widening the dynamics is cheap).'''\n",
    "    sub = arm(load('runs'), variant)\n",
    "    assert len(sub), 'no width-sweep results: run the stage first'\n",
    "    t = (sub['train_time_s'] / sub['n_iters']).groupby(sub['width']).median().sort_index()\n",
    "    P = sub.groupby('width')['dyn_params'].first().reindex(t.index).to_numpy(float)\n",
    "    t1, t0 = np.polyfit(P, t.to_numpy(float), 1)   # slope, intercept\n",
    "    share = t1 * P.max() / (t0 + t1 * P.max())\n",
    "    print(f'{variant}: time per iteration = {t0:.3e} + {t1:.3e} * P_dyn [s]; dynamics share at 4w*: {share:.1%}')\n",
    "    print('H2:', 'consistent with a cheap-dynamics split' if share < 0.5 else 'FALSIFIED (dynamics share > 50% at 4w*)')\n",
    "\n",
    "def h4_check(variant = 'L0'):\n",
    "    '''H4: improvement of the median test error from n* to 2n* at the canonical dynamics size (threshold 5%).'''\n",
    "    tab = medians(variant = variant)\n",
    "    sub = tab[(tab.K == ARM[variant]['K']) & (tab.width == W_STAR) & (tab.depth == L_STAR)].set_index('d_s')['med']\n",
    "    print(sub.to_string())\n",
    "    n1, n2 = N_STAR, 2 * N_STAR\n",
    "    if n1 in sub.index and n2 in sub.index:\n",
    "        improv = (sub[n1] - sub[n2]) / sub[n1]\n",
    "        print(f'{variant}: improvement n* = {n1} -> 2n* = {n2}: {improv:.1%}')\n",
    "        print('H4:', 'consistent with saturation at the intrinsic dimension' if improv < 0.05 else 'FALSIFIED (error keeps decreasing at 2n*)')\n",
    "    else:\n",
    "        print(f'{variant}: n* = {n1} or 2n* = {n2} missing: run the stage first')\n",
    "\n",
    "def failure_map():\n",
    "    '''Fraction of diverged (non-finite) runs per configuration.'''\n",
    "    runs = load('runs')\n",
    "    tab = runs.groupby(CFG_KEYS).agg(n = ('failed', 'size'), failed = ('failed', 'sum'))\n",
    "    tab['frac'] = tab['failed'] / tab['n']\n",
    "    print(tab.to_string())\n",
    "    if tab['failed'].sum() == 0:\n",
    "        print('no failures')\n",
    "\n",
    "def rank_table(variant = 'L0'):\n",
    "    '''Effective latent + Jacobian rank per latent size (H4 explainability add-on): collapsed extra latents explain a plateau.'''\n",
    "    runs = load('runs')\n",
    "    K = ARM[variant]['K']\n",
    "    sub = runs[(runs.variant == variant) & (runs.K == K) & (runs.width == W_STAR) & (runs.depth == L_STAR) & (~runs.failed.astype(bool))]\n",
    "    for n, g in sub.groupby('d_s'):\n",
    "        lr = [latent_rank(variant, K, W_STAR, L_STAR, n, s)[0] for s in g.seed]\n",
    "        jr = [jacobian_rank(variant, K, W_STAR, L_STAR, n, s)[0] for s in g.seed]\n",
    "        print(f'{variant} n = {n:3d}: latent rank {lr}, jacobian rank {jr}')\n",
    "\n",
    "def plot_arms():\n",
    "    '''L0 vs L2: median test NRMSE (min-max bars) against every cost measure, all configurations of both arms.'''\n",
    "    tab = medians()\n",
    "    fig, axs = plt.subplots(1, 4, figsize = (20, 4), sharey = True)\n",
    "    for ax, col, label in zip(axs, ['flops', 'fevs', 'time', 'p_total'],\n",
    "                              ['total operations (formula x n_fev)', 'function/gradient evaluations',\n",
    "                               'training time [s] (T = Pass T estimate, else Pass A)', 'parameters P_total']):\n",
    "        for v, c in (('L0', 'tab:blue'), ('L2', 'tab:red')):\n",
    "            t = tab[tab.variant == v]\n",
    "            ax.errorbar(t[col], t['med'], yerr = [t['med'] - t['lo'], t['hi'] - t['med']], fmt = 'o', color = c, capsize = 3, label = v)\n",
    "        ax.set(xscale = 'log', yscale = 'log', xlabel = label)\n",
    "        ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    axs[0].set_ylabel('test NRMSE')\n",
    "    axs[0].legend()\n",
    "    fig.suptitle('Linear (L2) vs nonlinear (L0) reconstructor: error vs cost')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def plot_linear_sweeps():\n",
    "    '''Where L2 wins or loses: error vs latent size n, vs P_dyn (width sweep), and vs K with the projection floor.'''\n",
    "    tab = medians()\n",
    "    fig, axs = plt.subplots(1, 3, figsize = (17, 4))\n",
    "    for v, K, c in (('L0', 0, 'tab:blue'), ('L2', K_L2, 'tab:red')):\n",
    "        t = tab[(tab.variant == v) & (tab.K == K) & (tab.width == W_STAR) & (tab.depth == L_STAR)].sort_values('d_s')\n",
    "        axs[0].errorbar(t.d_s, t['med'], yerr = [t['med'] - t['lo'], t['hi'] - t['med']], fmt = 'o-', color = c, capsize = 3, label = v)\n",
    "        w = arm(tab, v).sort_values('dyn')\n",
    "        axs[1].errorbar(w['dyn'], w['med'], yerr = [w['med'] - w['lo'], w['hi'] - w['med']], fmt = 'o-', color = c, capsize = 3,\n",
    "                        label = '%s (n = %d)' % (v, ARM[v]['d_s']))\n",
    "    axs[0].set(xscale = 'log', yscale = 'log', xlabel = 'latent size n (canonical dynamics, L2 at K = %d)' % K_L2, ylabel = 'test NRMSE')\n",
    "    axs[1].set(xscale = 'log', yscale = 'log', xlabel = 'P_dyn (width sweep)', ylabel = 'test NRMSE')\n",
    "    runs = load('runs')\n",
    "    kk = runs[(runs.variant == 'L2') & (runs.d_s == N_L2) & (runs.width == W_STAR) & (runs.depth == L_STAR)].groupby('K')[['eps_total_test', 'eps_proj_test']].median()\n",
    "    axs[2].plot(kk.index, kk['eps_total_test'], 'o-', color = 'tab:red', label = 'L2 total error (relative norm)')\n",
    "    axs[2].plot(kk.index, kk['eps_proj_test'], 's--', color = 'k', label = 'projection floor with K modes')\n",
    "    axs[2].set(xscale = 'log', yscale = 'log', xlabel = f'number of modes K (n = {N_L2})', ylabel = 'relative error')\n",
    "    for ax in axs:\n",
    "        ax.grid(True, which = 'both', alpha = 0.3)\n",
    "        ax.legend()\n",
    "    fig.suptitle('Linear arm sweeps (median over seeds)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def cost_to_reach(levels = (1.0, 1.25, 1.5, 2.0, 3.0)):\n",
    "    '''Cheapest configuration of each arm that reaches a median test NRMSE of `level` x the best L0 median: operations and time.'''\n",
    "    tab = medians()\n",
    "    best = tab[tab.variant == 'L0']['med'].min()\n",
    "    rows = []\n",
    "    for lv in levels:\n",
    "        row = {'target NRMSE': lv * best}\n",
    "        for v in ('L0', 'L2'):\n",
    "            ok = tab[(tab.variant == v) & (tab['med'] <= lv * best)]\n",
    "            row[f'{v} ops'] = ok['flops'].min() if len(ok) else np.nan\n",
    "            row[f'{v} time [s]'] = ok['time'].min() if len(ok) else np.nan\n",
    "        row['ops L0 / L2'] = row['L0 ops'] / row['L2 ops']\n",
    "        row['time L0 / L2'] = row['L0 time [s]'] / row['L2 time [s]']\n",
    "        rows.append(row)\n",
    "    print(pd.DataFrame(rows).to_string(index = False, float_format = lambda v: f'{v:.4g}'))\n",
    "    print('ratio > 1: L2 reaches the same error with less compute than L0; NaN: that arm never reaches the target')\n",
    "\n",
    "def plot_flops_check():\n",
    "    '''Does the operation-count formula predict the measured cost? Seconds per evaluation (Pass T) vs operations per evaluation, both arms.'''\n",
    "    tm = pd.read_csv(OUT / 'timing.csv')\n",
    "    d = tm.merge(load('runs').groupby(CFG_KEYS)['flops_per_eval'].first().reset_index(), on = CFG_KEYS)\n",
    "    fig, ax = plt.subplots(figsize = (6, 4.5))\n",
    "    for v, c in (('L0', 'tab:blue'), ('L2', 'tab:red')):\n",
    "        t = d[d.variant == v]\n",
    "        ax.loglog(t['flops_per_eval'], t['s_per_eval'], 'o', color = c, label = v)\n",
    "    ax.set(xlabel = 'operations per evaluation (formula)', ylabel = 'measured seconds per evaluation (Pass T)')\n",
    "    ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "    print('median seconds per operation (equal values for both arms = the formula ranks the arms correctly):')\n",
    "    print((d['s_per_eval'] / d['flops_per_eval']).groupby(d['variant']).median().to_string())\n",
    "\n",
    "def plot_svd_decay():\n",
    "    '''Singular-value decay of the training snapshots (Kolmogorov-width proxy, protocol Sec. 9).'''\n",
    "    fig, ax = plt.subplots(figsize = (6, 4))\n",
    "    ax.semilogy(np.arange(1, len(svd_decay) + 1), svd_decay, 'o-', ms = 3)\n",
    "    ax.set(xlabel = 'snapshot mode k', ylabel = 'sigma_k / sigma_1')\n",
    "    ax.grid(True, which = 'both', alpha = 0.3)\n",
    "    fig.suptitle('Snapshot singular-value decay (training data only)')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def latent_rank(variant, K, width, depth, d_s, seed):\n",
    "    '''Effective rank of the test latent trajectories (SVD, singular values above 1e-3 of the first).'''\n",
    "    states_of, _, _, _, _ = trained_nets(variant, K, width, depth, d_s, seed)\n",
    "    S = states_of('test').numpy().reshape(-1, d_s)\n",
    "    sv = np.linalg.svd(S, compute_uv = False)\n",
    "    return int((sv > 1e-3 * sv[0]).sum()), sv\n",
    "\n",
    "def jacobian_rank(variant, K, width, depth, d_s, seed, n_pts = 20):\n",
    "    '''Rank of d NNdyn/ds along test trajectories (singular values of the Jacobian, averaged over time).'''\n",
    "    states_of, _, base, _, _ = trained_nets(variant, K, width, depth, d_s, seed)\n",
    "    st = states_of('test')[0, :n_pts * 10:10].numpy()\n",
    "    uu = np.asarray(SPLITS['test']['inp_signals'])[0, :n_pts * 10:10]\n",
    "    inp = tf.constant(np.concatenate([st, uu], axis = -1))\n",
    "    with tf.GradientTape() as tape:\n",
    "        tape.watch(inp)\n",
    "        out = base(inp)          # dyn = base - base(0): same Jacobian\n",
    "    J = tape.batch_jacobian(out, inp)[:, :, :d_s].numpy()    # d out / d s only\n",
    "    sv = np.linalg.svd(J, compute_uv = False).mean(axis = 0)\n",
    "    return int((sv > 1e-3 * sv[0]).sum()), sv"
   ]
