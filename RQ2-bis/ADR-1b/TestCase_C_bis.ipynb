  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Experiment configuration\n",
    "\n",
    "BFGS-only training (0 Adam + 1000 BFGS, hard cap), identical for every run. The grid is fixed below; results already in `results/` are kept and the missing runs are added. The training settings cannot change inside one results folder (a guard checks them against `meta.json`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "worker"
    ]
   },
   "outputs": [],
   "source": [
    "# ---- Canonical sizes (protocol Sec. 2, confirmed from src/TestCase_3.py) ----\n",
    "N_STAR, W_STAR, L_STAR = 12, 8, 1     # latent size, dyn hidden width, dyn hidden layers\n",
    "\n",
    "# ---- Sweeps ----\n",
    "SEEDS = [0, 1, 2]                    # seed 0 is the seed of the original script\n",
    "WIDTHS = [2, 4, 8, 16, 32]           # {w*/4, w*/2, w*, 2w*, 4w*}\n",
    "DEPTHS = [1, 2, 3]                   # hidden tanh layers of the dyn base (L* = 1)\n",
    "N_LIST = [3, 6, 12, 24]              # L0: {n*/4, n*/2, n*, 2n*}\n",
    "\n",
    "# ---- Linear arm, Stage 7: L2 = y_bar + sum_k (W s + b)_k phi_k, trained end-to-end (R2) ----\n",
    "K_L2, K_LEVELS_L2 = 65, [5, 17, 33, 65]   # main number of modes (largest basis computed) and the K sweep\n",
    "N_LIST_L2, N_L2 = [3, 6, 12, 24], 12      # n sweep at K = K_L2; width and K sweeps at n = N_L2\n",
    "\n",
    "# A configuration is (variant, K, width, depth, d_s); K = 0 for L0 (it has no modes)\n",
    "CANON = ('L0', 0, W_STAR, L_STAR, N_STAR)\n",
    "ARM = {'L0': dict(K = 0, d_s = N_STAR), 'L2': dict(K = K_L2, d_s = N_L2)}    # slice of the width sweep of each arm\n",
    "STAGE1 = [('L0', 0, w, L_STAR, N_STAR) for w in WIDTHS] + [('L0', 0, W_STAR, L, N_STAR) for L in DEPTHS if L != L_STAR]\n",
    "STAGE2 = [('L0', 0, W_STAR, L_STAR, n) for n in N_LIST if n != N_STAR]\n",
    "STAGE7 = list(dict.fromkeys([('L2', K_L2, W_STAR, L_STAR, n) for n in N_LIST_L2]\n",
    "                            + [('L2', K_L2, w, L_STAR, N_L2) for w in WIDTHS]\n",
    "                            + [('L2', K, W_STAR, L_STAR, N_L2) for K in K_LEVELS_L2]))\n",
    "print(f'configs: Stage 1 {len(STAGE1)}, Stage 2 {len(STAGE2)}, Stage 7 {len(STAGE7)}; x {len(SEEDS)} seeds = '\n",
    "      f'{(len(STAGE1) + len(STAGE2)) * len(SEEDS)} L0 runs + {len(STAGE7) * len(SEEDS)} L2 runs')\n",
    "\n",
    "# ---- Training: BFGS-only, fixed budget ----\n",
    "EPOCHS_ADAM, EPOCHS_BFGS, LR_ADAM, ALPHA_REG = 0, 1000, 1e-2, 4.7e-3\n",
    "CHECKPOINTS = [25, 50, 100, 200, 500, 1000]   # Stage 3: error surface from a single run (no extra runs)\n",
    "K_REF = 33                                     # fixed Legendre reference for the efficiency ratio of L0 (L2 uses its own K)\n",
    "TARGETS = [5e-2, 2e-2, 1e-2]                   # NRMSE targets for time-to-target (protocol Sec. 11 defaults)\n",
    "\n",
    "# ---- Results folder ----\n",
    "OUT = pathlib.Path('results')\n",
    "(OUT / 'weights').mkdir(parents = True, exist_ok = True)\n",
    "\n",
    "# The results of all the sessions must come from the same training settings (and the first session is recorded)\n",
    "training = dict(optimizer = 'scipy-BFGS', epochs_adam = EPOCHS_ADAM, epochs_bfgs = EPOCHS_BFGS, lr_adam = LR_ADAM,\n",
    "                alpha_reg = ALPHA_REG, checkpoints = CHECKPOINTS, k_ref = K_REF, k_l2 = K_L2)\n",
    "if (OUT / 'meta.json').exists():\n",
    "    assert json.loads((OUT / 'meta.json').read_text())['training'] == training, f'{OUT}/ holds results with other training settings: use another OUT'\n",
    "else:\n",
    "    git = subprocess.run('git rev-parse --short HEAD', shell = True, capture_output = True, text = True).stdout.strip()\n",
    "    (OUT / 'meta.json').write_text(json.dumps(dict(tensorflow = tf.__version__, numpy = np.__version__, scipy = scipy.__version__,\n",
    "                                                   pandas = pd.__version__, git = git, training = training), indent = 2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Helpers\n",
    "\n",
    "### Fixed ingredients\n",
    "\n",
    "Mean field $\\bar y(x)$ (training data only) and the Legendre basis, orthonormalised on the 101-point grid with the trapezoidal discrete $L^2$ product — the same computation as RQ2. Only the first $K_{\\mathrm{ref}}=33$ columns are used (efficiency-ratio floor). `svd_decay` is the snapshot singular-value decay for the analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "worker"
    ]
   },
   "outputs": [],
   "source": [
    "SPLITS = {'train': dataset_train, 'valid': dataset_valid, 'test': dataset_tests}\n",
    "denorm = lambda a: np.asarray(utils.denormalize_output(a, problem, normalization))\n",
    "REF = {s: denorm(d['out_fields']) for s, d in SPLITS.items()}     # FOM fields [S, T, n, 1]; train/valid sampled, test full grid\n",
    "\n",
    "assert dataset_train['num_times'] == 501 and dataset_valid['num_times'] == 501 and dataset_tests['num_times'] == 501\n",
    "assert dataset_train['num_points'] == 20 and dataset_tests['num_points'] == 101\n",
    "\n",
    "P = len(points_phys)                # 101: uniform grid on [0, 100], both endpoints included\n",
    "xs = np.unique(points_phys[:, 0])\n",
    "assert len(xs) == P, 'the grid is not 1D Cartesian'\n",
    "dx = xs[1] - xs[0]\n",
    "assert np.allclose(np.diff(xs), dx) and np.isclose(dx, 1.0), 'the grid is not uniform with spacing 1'\n",
    "xn = np.asarray(dataset_tests['points'][:, 0])                   # [-1, 1] normalised grid (Legendre domain)\n",
    "assert np.allclose(xn, xs / 50 - 1), 'normalised grid is not [-1, 1]'\n",
    "w = np.full(P, 2 / (P - 1))                                      # trapezoidal weights on [-1, 1]\n",
    "w[0] = w[-1] = 1 / (P - 1)\n",
    "\n",
    "IDXS = {'train': dataset_train['idxs'], 'valid': dataset_valid['idxs'], 'test': None}\n",
    "XFULL = {s: tf.constant(np.asarray(SPLITS[s]['points_full'], dtype = np.float64)) for s in SPLITS}   # network inputs (normalised)\n",
    "IDX_TF = {s: tf.constant(IDXS[s]) for s in ('train', 'valid')}\n",
    "\n",
    "def legendre_vander(x, K):\n",
    "    '''First K Legendre polynomials at x [...]: [..., K] (plain recurrence).'''\n",
    "    polys = [np.ones_like(x), x.copy()]\n",
    "    for n in range(1, K - 1):\n",
    "        polys.append(((2 * n + 1) * x * polys[n] - n * polys[n - 1]) / (n + 1))\n",
    "    return np.stack(polys[:K], axis = -1)\n",
    "\n",
    "K_BASIS = 65                        # modes computed (protocol maximum; the floor uses K_REF)\n",
    "V = legendre_vander(xn, K_BASIS)                                 # [P, K_BASIS] Vandermonde on the full grid\n",
    "Q, R = np.linalg.qr(np.sqrt(w)[:, None] * V)\n",
    "PHI = Q / np.sqrt(w)[:, None]                                    # [P, K_BASIS] w-orthonormal vector basis\n",
    "assert np.allclose((PHI * w[:, None]).T @ PHI, np.eye(K_BASIS)), 'the Legendre basis is not orthonormal for <f, g>_w'\n",
    "assert K_REF <= K_BASIS and K_L2 <= K_BASIS\n",
    "PHIFULL_TF = tf.constant(PHI)\n",
    "\n",
    "y_bar_n = dataset_full['out_fields'].numpy().mean(axis = (0, 1))[:, 0]   # [P] mean field (normalised units)\n",
    "y_bar = denorm(y_bar_n[None, None, :, None])[0, 0, :, 0]                 # [P] the same in physical units\n",
    "YBN_TF = tf.constant(y_bar_n)\n",
    "\n",
    "F_full = denorm(dataset_full['out_fields'])[..., 0]              # [S, T, P] full-grid training fields (physical)\n",
    "Zsvd = (F_full[:, ::10] - y_bar).reshape(-1, P)                  # mean-subtracted snapshots, every 10th step\n",
    "svd_decay = np.linalg.svd(Zsvd, compute_uv = False)              # singular values (Kolmogorov-width proxy)\n",
    "svd_decay = svd_decay / svd_decay[0]\n",
    "del F_full, Zsvd"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Networks and latent dynamics\n",
    "\n",
    "`build_dyn(d_s, width, depth)` is the swept dynamics: trainable base with `depth` hidden tanh layers of `width`, minus its own value at the equilibrium $(\\mathbf{0},\\mathbf{0})$. As in the original script (`NNdyn_base(inp) - NNdyn_base(inp_eq)`), the offset is **recomputed at every call**, so the dynamics vanish at rest throughout training (a constant computed once at initialisation would not). The reconstructors are `build_L0` (the original $17^5 \\to 1$ on $(\\mathbf{s},x)$, fixed architecture) and `build_L2` (affine map $\\mathbf{s} \\mapsto \\mathbb{R}^K$ followed by the fixed Legendre synthesis `decode`). `basis_at` gathers the basis and mean field at the sampled training points **once** per $(\\text{split},K)$: the gather is a data-layout choice, not part of the per-iteration cost being measured. `evolve` and `weights_reg` are those of the original script. Parameter counts are read off the built models, never by hand; `flops_per_eval` is the formula count described in the introduction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "worker"
    ]
   },
   "outputs": [],
   "source": [
    "N_COMP = len(problem['output_fields'])\n",
    "\n",
    "def set_seed(seed):\n",
    "    np.random.seed(seed)\n",
    "    tf.random.set_seed(seed)\n",
    "\n",
    "def build_dyn(d_s, width = W_STAR, depth = L_STAR):\n",
    "    '''Trainable base (depth hidden tanh layers of width) and equilibrium-subtracted dynamics. Canonical: width = 8, depth = 1.'''\n",
    "    layers = [tf.keras.layers.Dense(width, activation = tf.nn.tanh, input_shape = (d_s + 2,))]\n",
    "    layers += [tf.keras.layers.Dense(width, activation = tf.nn.tanh) for _ in range(depth - 1)]\n",
    "    layers += [tf.keras.layers.Dense(d_s)]\n",
    "    base = tf.keras.Sequential(layers)                                        # on (s, u1, u2)\n",
    "    inp_eq = tf.zeros((1, d_s + 2), dtype = tf.float64)\n",
    "    def dyn(inp):\n",
    "        return base(inp) - base(inp_eq)                                       # offset re-evaluated at every call, as in the original script\n",
    "    return base, dyn\n",
    "\n",
    "def count_params(nets):\n",
    "    '''Trainable parameters, counted from the built models.'''\n",
    "    return sum(int(np.prod(v.shape)) for n in nets for v in n.variables)\n",
    "\n",
    "def evolve(dyn, d_s, dataset):\n",
    "    '''Latent states [S, T, d_s]: Forward Euler from s(0) = 0 (evolve_dynamics of the original script).'''\n",
    "    state = tf.zeros((dataset['num_samples'], d_s), dtype = tf.float64)\n",
    "    state_history = tf.TensorArray(tf.float64, size = dataset['num_times'])\n",
    "    state_history = state_history.write(0, state)\n",
    "    dt_ref = normalization['time']['time_constant']\n",
    "    for i in tf.range(dataset['num_times'] - 1):\n",
    "        state = state + dt/dt_ref * dyn(tf.concat([state, dataset['inp_signals'][:,i,:]], axis = -1))\n",
    "        state_history = state_history.write(i + 1, state)\n",
    "    return tf.transpose(state_history.stack(), perm=(1, 0, 2))\n",
    "\n",
    "def weights_reg(NN):\n",
    "    return sum([tf.reduce_mean(tf.square(lay.kernel)) for lay in NN.layers])/len(NN.layers)\n",
    "\n",
    "_BASIS = {}\n",
    "def basis_at(split, K):\n",
    "    '''Mean field and first K Legendre modes at the points of `split` (normalised units), built once per (split, K).'''\n",
    "    if (split, K) not in _BASIS:\n",
    "        B = PHIFULL_TF[:, :K]                                                  # [P, K]\n",
    "        if split == 'test':\n",
    "            _BASIS[(split, K)] = (YBN_TF[None, None, :, None], B)\n",
    "        else:\n",
    "            _BASIS[(split, K)] = (tf.gather(YBN_TF, IDX_TF[split])[..., None], tf.gather(B, IDX_TF[split]))   # [S, T, n, 1], [S, T, n, K]\n",
    "    return _BASIS[(split, K)]\n",
    "\n",
    "def decode(coeffs, split, K):\n",
    "    '''y_bar + sum_k coeffs_k * phi_k at the points of `split`: coeffs [S, T, K] -> [S, T, n, 1] (normalised units).'''\n",
    "    ybar, basis = basis_at(split, K)\n",
    "    if split == 'test':\n",
    "        return ybar + tf.einsum('stk,pk->stp', coeffs, basis)[..., None]\n",
    "    return ybar + tf.einsum('stk,stnk->stn', coeffs, basis)[..., None]\n",
    "\n",
    "def build_L0(d_s, K):                                                       # K is not used\n",
    "    NNrec = tf.keras.Sequential([                                           # the original 17^5 -> 1, inputs (s, x)\n",
    "        tf.keras.layers.Dense(17, activation = tf.nn.tanh, input_shape = (None, None, d_s + 1)),\n",
    "        tf.keras.layers.Dense(17, activation = tf.nn.tanh),\n",
    "        tf.keras.layers.Dense(17, activation = tf.nn.tanh),\n",
    "        tf.keras.layers.Dense(17, activation = tf.nn.tanh),\n",
    "        tf.keras.layers.Dense(17, activation = tf.nn.tanh),\n",
    "        tf.keras.layers.Dense(1)])\n",
    "    def rec(states, split):\n",
    "        S, T = tf.shape(states)[0], tf.shape(states)[1]\n",
    "        n = XFULL[split].shape[2]\n",
    "        sb = tf.broadcast_to(states[:, :, None, :], [S, T, n, d_s])\n",
    "        return NNrec(tf.concat([sb, XFULL[split]], axis = -1))\n",
    "    return rec, [NNrec]\n",
    "\n",
    "def build_L2(d_s, K):\n",
    "    affine = tf.keras.Sequential([tf.keras.layers.Dense(K, input_shape = (None, d_s))])   # c = W s + b\n",
    "    for split in SPLITS:\n",
    "        basis_at(split, K)                                                  # gathered eagerly here: building it inside the traced loss would leak graph tensors\n",
    "    def rec(states, split):\n",
    "        return decode(affine(states), split, K)\n",
    "    return rec, [affine]\n",
    "\n",
    "BUILD = {'L0': build_L0, 'L2': build_L2}\n",
    "\n",
    "def flops_per_eval(variant, K, dyn_params, rec_params):\n",
    "    '''Multiply-add count of one loss+gradient evaluation on the training set: 3 x forward (backward ~ 2 x forward), activations ignored.'''\n",
    "    d = SPLITS['train']\n",
    "    S, T, N = d['num_samples'], d['num_times'], d['num_points']\n",
    "    fwd_dyn = 2 * dyn_params * S * (T - 1)\n",
    "    if variant == 'L0':\n",
    "        fwd_rec = 2 * rec_params * S * T * N\n",
    "    else:                                                                    # affine map of the latents + modal synthesis at every point\n",
    "        fwd_rec = 2 * rec_params * S * T + 2 * K * N_COMP * S * T * N\n",
    "    return 3 * (fwd_dyn + fwd_rec)"
   ]
