   "outputs": [],
   "source": [
    "def setup_run(variant, K, width, depth, d_s, seed):\n",
    "    '''Re-creates from the seed all the objects of a run: states_of(split), the reconstructor, the dynamics base, the reconstructor networks, dyn.'''\n",
    "    set_seed(seed)\n",
    "    with cpu_device():\n",
    "        base, dyn = build_dyn(d_s, width, depth)\n",
    "        rec, rec_nets = BUILD[variant](d_s, K)\n",
    "    def states_of(split):\n",
    "        return evolve(dyn, d_s, SPLITS[split])\n",
    "    return states_of, rec, base, rec_nets, dyn\n",
    "\n",
    "def trained_nets(variant, K, width, depth, d_s, seed):\n",
    "    '''Stored run rebuilt from its saved weights (no training). Variable order matches run_one.'''\n",
    "    states_of, rec, base, rec_nets, dyn = setup_run(variant, K, width, depth, d_s, seed)\n",
    "    variables = [v for n in [base] + rec_nets for v in n.variables]\n",
    "    optimization.VariablesStitcher(variables).update_variables(np.load(OUT / 'weights' / f'{run_id(variant, K, width, depth, d_s, seed)}.npy'))\n",
    "    return states_of, rec, base, rec_nets, dyn\n",
    "\n",
    "def seconds(f):\n",
    "    t0 = time.perf_counter()\n",
    "    f()\n",
    "    return time.perf_counter() - t0\n",
    "\n",
    "def make_losses(states_of, rec, nets):\n",
    "    '''Training and validation loss of the original script: MSE + ALPHA_REG * weight regularisation of all the trained networks.'''\n",
    "    def mse(split):\n",
    "        return tf.reduce_mean(tf.square(rec(states_of(split), split) - SPLITS[split]['out_fields']))\n",
    "    def loss():\n",
    "        return mse('train') + ALPHA_REG * sum(weights_reg(n) for n in nets)\n",
    "    def loss_valid():\n",
    "        return mse('valid')\n",
    "    return loss, loss_valid\n",
    "\n",
    "def run_one(variant, K, width, depth, d_s, seed):\n",
    "    '''Trains one run (BFGS-only) and appends its results to the CSV files.'''\n",
    "    key = dict(variant = variant, K = K, width = width, depth = depth, d_s = d_s, seed = seed)\n",
    "    states_of, rec, base, rec_nets, _ = setup_run(**key)\n",
    "    nets = [base] + rec_nets\n",
    "    variables = [v for n in nets for v in n.variables]\n",
    "    dyn_params, rec_params = count_params([base]), count_params(rec_nets)\n",
    "    loss, loss_valid = make_losses(states_of, rec, nets)\n",
    "\n",
    "    curves, ck_time = [], [0.0]\n",
    "    with contextlib.redirect_stdout(io.StringIO()):           # silences the per-epoch log of optimization.py\n",
    "        t0 = time.perf_counter()\n",
    "        opt = optimization.OptimizationProblem(variables, loss, loss_valid)\n",
    "        trace_time = time.perf_counter() - t0                 # tf.function tracing: reported, not part of the training time\n",
    "        if EPOCHS_ADAM:\n",
    "            opt.optimize_keras(EPOCHS_ADAM, tf.keras.optimizers.Adam(learning_rate = LR_ADAM))\n",
    "        t0 = time.perf_counter()\n",
    "        def checkpoint():                                     # Stage 3: observe the single run, never steer it\n",
    "            k = opt.iteration - 1 - EPOCHS_ADAM               # BFGS iterations completed (the hook runs after iteration_callback)\n",
    "            if k in CHECKPOINTS:\n",
    "                tc = time.perf_counter()\n",
    "                curves.append(dict(iter = k, n_fev = opt.n_fev, time_s = tc - t0 - ck_time[0],\n",
    "                                   loss_train = float(opt.ag_train_loss().numpy()),\n",
    "                                   loss_valid = float(opt.ag_valid_loss().numpy()),\n",
    "                                   nrmse_valid = nrmse_only(denorm(rec(states_of('valid'), 'valid')), REF['valid']),\n",
    "                                   nrmse_test = nrmse_only(denorm(rec(states_of('test'), 'test')), REF['test'])))\n",
    "                ck_time[0] += time.perf_counter() - tc        # checkpoint evaluations are not training time\n",
    "        opt.optimize_BFGS(EPOCHS_BFGS, callback_extra = checkpoint)\n",
    "        train_time = time.perf_counter() - t0 - ck_time[0]\n",
    "    n_iters, n_fev = int(opt.iteration) - 1 - EPOCHS_ADAM, int(opt.n_fev)\n",
    "    if n_iters < EPOCHS_BFGS:\n",
    "        print(f'  warning: scipy stopped after {n_iters} < {EPOCHS_BFGS} iterations (checkpoints after that are missing)')\n",
    "\n",
    "    states = {s: states_of(s) for s in SPLITS}                    # [S, T, d_s]\n",
    "    pred = {s: denorm(rec(states[s], s)) for s in SPLITS}         # [S, T, P, 1]\n",
    "    ref, app = REF['test'], pred['test']\n",
    "    failed = not all(np.isfinite(p).all() for p in pred.values())\n",
    "\n",
    "    row = dict(key, dyn_params = dyn_params, rec_params = rec_params, p_total = dyn_params + rec_params,\n",
    "               flops_per_eval = flops_per_eval(variant, K, dyn_params, rec_params), n_fev = n_fev, n_iters = n_iters,\n",
    "               trace_time_s = trace_time, train_time_s = train_time,\n",
    "               infer_time_s = min(seconds(lambda: rec(states['test'], 'test')) for _ in range(3)), failed = failed)\n",
    "    row['flops_total'] = row['flops_per_eval'] * n_fev\n",
    "    if failed:                                                    # diverged: logged and counted, the sweep goes on\n",
    "        print('  FAILED: non-finite predictions (stored with NaN metrics)')\n",
    "        for s in SPLITS:\n",
    "            row[f'nrmse_{s}'] = row[f'one_minus_rho_{s}'] = np.nan\n",
    "        for c in ['eps_total_test', 'eps_proj_test', 'eff_ratio_test', *EXTRA_COLS]:\n",
    "            row[c] = np.nan\n",
    "    else:\n",
    "        K_floor = K if variant == 'L2' else K_REF\n",
    "        for s in SPLITS:\n",
    "            row[f'nrmse_{s}'], row[f'one_minus_rho_{s}'] = nrmse_rho(pred[s], REF[s])\n",
    "        eps_total = np.linalg.norm(app - ref) / np.linalg.norm(ref)\n",
    "        eps_proj = np.linalg.norm(proj_residual(ref, K_floor)) / np.linalg.norm(ref)\n",
    "        row.update(eps_total_test = eps_total, eps_proj_test = eps_proj, eff_ratio_test = eps_total / eps_proj)\n",
    "        _, (mae, miss) = act_metrics(app, ref)\n",
    "        row.update(act_mae_test = float(mae), act_miss_test = float(miss))\n",
    "        append('predictions', with_key(prediction_table(app, ref, K_floor), key))\n",
    "\n",
    "    rid = run_id(**key)\n",
    "    np.save(OUT / 'weights' / f'{rid}.npy', optimization.VariablesStitcher(variables).stitch().numpy())\n",
    "    append('curves', with_key(pd.DataFrame(curves), key))\n",
    "    append('runs', pd.DataFrame([row]))                           # last: a run is done only when its row is in runs.csv\n",
    "    print(f'{rid:34s} train {train_time:6.1f} s   iters {n_iters:4d}   fevs {n_fev:5d}   test NRMSE {row[\"nrmse_test\"]:.3e}')\n",
    "\n",
    "def sweep(configs, label):\n",
    "    '''Runs the missing (seed, configuration) pairs of an explicit configuration list; the finished ones (rows of runs.csv) are skipped.'''\n",
    "    done = set()\n",
    "    if (OUT / 'runs.csv').exists():\n",
    "        runs = load('runs')\n",
    "        done = set(zip(runs.variant, runs.K, runs.width, runs.depth, runs.d_s, runs.seed))\n",
    "    grid = [(*c, s) for s in SEEDS for c in configs]\n",
    "    todo = [g for g in grid if g not in done]\n",
    "    print(f'{label}: {len(todo)} runs to do, {len(grid) - len(todo)} already done')\n",
    "    for i, g in enumerate(todo, 1):\n",
    "        print(f'[{i}/{len(todo)}]', end = ' ')\n",
    "        run_one(*g)\n",
    "\n",
    "def predict_test(variant, K, width, depth, d_s, seed):\n",
    "    '''Test prediction of a stored run, rebuilt from its saved weights (no training).'''\n",
    "    states_of, rec, _, _, _ = trained_nets(variant, K, width, depth, d_s, seed)\n",
    "    return denorm(rec(states_of('test'), 'test'))\n",
    "\n",
    "def time_eval(variant, K, width, depth, d_s, seed, reps = 3, calls = 20):\n",
    "    '''Seconds per joint function/gradient evaluation (the unit of BFGS cost) on a stored run: median over `reps` of the mean of `calls`\n",
    "    evaluations, after a warm-up call.'''\n",
    "    states_of, rec, base, rec_nets, _ = trained_nets(variant, K, width, depth, d_s, seed)\n",
    "    nets = [base] + rec_nets\n",
    "    variables = [v for n in nets for v in n.variables]\n",
    "    loss, loss_valid = make_losses(states_of, rec, nets)\n",
    "    with contextlib.redirect_stdout(io.StringIO()):\n",
    "        opt = optimization.OptimizationProblem(variables, loss, loss_valid)\n",
    "    p = opt.stitcher.stitch(variables).numpy()\n",
    "    opt.ag_train_loss_grad_numpy(p)                               # warm-up\n",
    "    return float(np.median([seconds(lambda: [opt.ag_train_loss_grad_numpy(p) for _ in range(calls)]) / calls for _ in range(reps)]))"
   ]
  },
