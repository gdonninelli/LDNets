    "# import modules\n",
    "import contextlib\n",
    "import io\n",
    "import json\n",
    "import os\n",
    "import pathlib\n",
    "import platform\n",
    "import subprocess\n",
    "import sys\n",
    "import time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import scipy.stats\n",
    "import tensorflow as tf\n",
    "\n",
    "# We configure TensorFlow to work in double precision\n",
    "tf.keras.backend.set_floatx('float64')\n",
    "\n",
    "# Double precision must run on the CPU here: the Apple Metal GPU plugin only registers\n",
    "# single-precision kernels (e.g. ResourceApplyAdam with T=DT_DOUBLE is missing).\n",
    "# We first try to hide the GPU; if the kernel already initialized it (e.g. this cell is\n",
    "# re-run in an old session), we fall back to creating all model variables on /CPU:0.\n",
    "try:\n",
    "    tf.config.set_visible_devices([], 'GPU')\n",
    "except RuntimeError:\n",
    "    pass  # devices already initialized: fall back to the CPU device scope below\n",
    "if tf.config.get_visible_devices('GPU'):\n",
    "    print('GPU already initialized -> model variables will be created on /CPU:0.')\n",
    "    cpu_device = lambda: tf.device('/CPU:0')\n",
    "else:\n",
    "    print('Running on CPU (float64).')\n",
    "    cpu_device = contextlib.nullcontext\n",
    "\n",
    "# Reproducibility: deterministic TensorFlow kernels. Random initialisers then require tf.random.set_seed,\n",
    "# which setup_run() calls right before it creates the networks of a run.\n",
    "tf.config.experimental.enable_op_determinism()\n",
    "\n",
    "# Every run builds new tf.functions: this silences the \"tf.function retracing\" warnings that this triggers.\n",
    "tf.get_logger().setLevel('ERROR')\n",
    "\n",
    "import utils\n",
    "import optimization\n",
    "\n",
    "# utils.py is the copy in this folder: identical to src/ except process_dataset also stores\n",
    "# dataset['idxs'] (None without subsampling). optimization.py is the RQ2 copy plus an\n",
    "# observation hook (callback_extra) and an evaluation counter (n_fev); the BFGS algorithm\n",
    "# and its tolerances are untouched.\n",
    "print('utils        ->', utils.__file__)\n",
    "print('optimization ->', optimization.__file__)"
   ]
